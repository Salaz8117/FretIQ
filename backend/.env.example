# Music Chords App - Backend Configuration
# Copy this to .env and fill in your API keys

# AI Provider API Keys (at least one required)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Local AI Gateway (optional - for free local models)
# FREE_LLMAPI_URL=http://localhost:3001/v1
# FREE_LLMAPI_KEY=your_local_key_here

# Search API Keys (optional - for web scraping fallback)
# SERPAPI_KEY=your_serpapi_key_here
# BING_API_KEY=your_bing_api_key_here

# App Settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# Cache Settings
CACHE_TTL=3600  # 1 hour
MAX_CACHE_SIZE=1000

# Rate Limiting
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60  # seconds